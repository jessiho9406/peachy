<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Quay lại"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/ink"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="thêm ngày"
                android:textColor="@color/ink"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            style="@style/Label"
            android:text="widget sẽ trông như vầy" />

        <FrameLayout
            android:id="@+id/preview_holder"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:clipChildren="false"
            android:elevation="6dp" />

        <TextView
            style="@style/Label"
            android:text="tên ngày" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="VD: Ngày cưới, Sinh nhật con…"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ink"
            android:textColorHint="#B8ABA4"
            android:textSize="16sp" />

        <TextView
            style="@style/Label"
            android:text="ngày nào nè (dương lịch)" />

        <TextView
            android:id="@+id/date_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lunar_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink_soft"
            android:textSize="12.5sp" />

        <TextView
            style="@style/Label"
            android:text="lặp lại hằng năm" />

        <LinearLayout
            android:id="@+id/repeat_group"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="Âm lịch dùng cho giỗ, sinh nhật âm… tự đổi sang ngày dương mỗi năm."
            android:textColor="@color/ink_soft"
            android:textSize="12.5sp" />

        <Switch
            android:id="@+id/first"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="tính ngày bắt đầu là ngày 1"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            style="@style/Label"
            android:text="biểu cảm của đào" />

        <LinearLayout
            android:id="@+id/mascot_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            style="@style/Label"
            android:text="màu widget" />

        <LinearLayout
            android:id="@+id/theme_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="lưu nè"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="lưu &amp; ghim ra màn hình 📌"
            android:textColor="@color/accent"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/del"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="xoá ngày này"
            android:textColor="@color/danger"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
